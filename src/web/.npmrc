# This mirror is substantially faster on the supported build host. Package
# integrity remains locked in package-lock.json. Keep concurrency at one:
# npm 10.2 can otherwise retain over one hundred CDN sockets and never exit.
registry=https://registry.npmmirror.com/
maxsockets=1
progress=false
fetch-retries=3
fetch-timeout=120000
prefer-offline=true
update-notifier=false
