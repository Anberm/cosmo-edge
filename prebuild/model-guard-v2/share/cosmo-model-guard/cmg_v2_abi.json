  "visibility": {
    "default_visibility": "hidden",
    "version_script_required": true,
    "version_node": "CMG_2.0",
    "global_function_allowlist": [
      "CmgV2OpenArtifact",
      "CmgV2GetArtifactInfo",
      "CmgV2LoadSophonSegment",
      "CmgV2CloseArtifact"
    ],
    "all_other_symbols": "local",
    "exclude_static_dependency_symbols": true
  },
  "compatibility_rules": {
    "all_nonzero_statuses_are_failures": true,
    "unknown_status_handling": "treat-as-failure",
    "open_failure_sets_out_artifact_null": true,
    "load_failure_sets_out_bmrt_null": true,
    "close_null_is_noop": true,
    "artifact_handle_thread_safe": false,
    "concurrent_load_get_close": "forbidden",
    "close_exactly_once": true,
    "close_does_not_destroy_transferred_bmrt": true,
    "bm_handle_ownership": "borrowed-until-transferred-bmrt-destroyed",
    "authenticated_io_or_crypto_load_failure": "poison-artifact-handle",
    "backend_failure": "sequential-retry-allowed",
    "future_struct_extensions": {
      "append_only": true,
      "callee_never_writes_beyond_known_prefix": true,
      "future_required_semantics_need_unknown_flag": true,
      "reason": "An older guard must reject required behavior rather than silently ignore a tail extension."
    },
    "public_header_must_remain_c_compatible": true,
    "public_header_must_not_expose": [
      "product-model-key",
      "plaintext-buffer",
      "plaintext-pointer",
      "plaintext-file-descriptor"
    ]
  },
  "runtime_profile": {
    "name": "v2-only",
    "binding_profile": "software-bound-device-certificate-v1",
    "authorization_artifact": "device-certificate.bin",
    "preset_scope": "all-current-and-future-presets-under-one-pmk"
  }
